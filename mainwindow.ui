    <property name="styleSheet">
     <string notr="true">QComboBox {
    background-color: white;
    color: black;
    border: 1px solid #ccc;
    border-radius: 10px;
    padding: 4px 8px;
    font-size: 12px;
}

/* Phần chứa mũi tên */
QComboBox::drop-down {
    width: 20px;
    border: none;
    background-color: #f5f5f5; /* ✅ đổi màu nền chỗ chứa mũi tên */
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* Mũi tên */
QComboBox::down-arrow {
    image: url(:/icons/arrow-down.png); /* ✅ dùng icon tùy chỉnh nếu có */
    width: 10px;
    height: 10px;
}

/* Nền của danh sách khi xổ ra */
QComboBox QAbstractItemView {
    background-color: white;
    selection-background-color: #ffc0cb;  /* ✅ màu hồng nhẹ khi chọn */
    color: black;
    border: 1px solid #ccc;
}
</string>
